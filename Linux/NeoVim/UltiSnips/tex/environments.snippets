snippet img "Insert Image"
\begin{figure}[H]
	\begin{center}
		\includegraphics[width=.5\textwidth]{${1:url}}
	\end{center}
	\caption{${2:caption}}
	\label{fig:${3:label}}
\end{figure}$0
endsnippet


snippet img2 "Insert Image Side by Side"
\begin{figure}[H]
	\begin{subfigure}{0.5\textwidth}
		\includegraphics[width=.5\textwidth]{${1:url}}
		\caption{${2:caption}}
		\label{fig:${3:label}}
	\end{subfigure}
	\begin{subfigure}{0.5\textwidth}
		\includegraphics[width=.5\textwidth]{${4:url}}
		\caption{${5:caption}}
		\label{fig:${6:label}}
	\end{subfigure}
	\caption{${7:caption}}
	\label{fig:${8:label}}
\end{figure}$0
endsnippet

snippet env "Environment"
\begin{$1}
	$2
\end{$1}
$0
endsnippet

snippet itm "Environment: itemize"
\begin{itemize}
	\item $1
\end{itemize}
$0
endsnippet


snippet enm "Environment: enumerate"
\begin{enumerate}
	\item $1
\end{enumerate}
$0
endsnippet

snippet sys "Equation system request 'amsmath'"
\begin{equation*}
    \left\{
        \begin{align*}
	    $1\\\
	    $2
        \end{align*}
    \right.
\end{equation*}$0
endsnippet

snippet cases "Cases Environment requests 'amsmath'"
$\begin{cases}
    $1 \\\
    $2 
\end{cases}$$0
endsnippet


snippet frame "Frame environment in 'beamer'"
\begin{frame}
\frametitle{$1}
	$2
\end{frame}$0
endsnippet

snippet tabular
\begin{center}
	\begin{tabular}{|*{$1}{c|}}
	\hline
	$2
	\end{tabular}
\end{center}
endsnippet

snippet tabularx
\begin{center}
	\begin{tabularx}{$1\textwidth}{|*{$2}{c|}}
	\hline
	$3 \\
	\hline
	\end{tabularx}
\end{center}
endsnippet

snippet rnd_b
\left($1\right)$0
endsnippet

snippet cur_b
\left\\{$1\right\\}$0
endsnippet


snippet sqr_b
\left[$1\right]$0
endsnippet

snippet dfrac
\dfrac{$1}{$2}$0
endsnippet


snippet frac
\frac{$1}{$2}$0
endsnippet

snippet __
_{$1}$0
endsnippet

snippet \^^
^{$1}$0
endsnippet


snippet $$
^{$1}$0
endsnippet
